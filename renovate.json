{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>projectbluefin/renovate-config"
  ],
  "forkProcessing": "enabled",
  "baseBranchPatterns": [
    "testing"
  ],
  "enabledManagers": [
    "custom.regex",
    "github-actions"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Follow fsdk-containers main through the junction ref",
      "managerFilePatterns": [
        "/^elements\\/fsdk-containers\\.bst$/"
      ],
      "matchStrings": [
        "track: (?<currentValue>main)\\n    ref: (?<currentDigest>[0-9a-f]{40})"
      ],
      "depNameTemplate": "https://github.com/projectbluefin/fsdk-containers",
      "datasourceTemplate": "git-refs"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "automerge": false
    },
    {
      "description": "fsdk-containers bumps go through the merge queue once the required FSDK checks pass; git-refs digests have no release timestamp, so no release-age hold",
      "matchDepNames": [
        "https://github.com/projectbluefin/fsdk-containers"
      ],
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": false,
      "minimumReleaseAge": null
    },
    {
      "description": "BuildStream builds fail on ubuntu-26.04 runners (fsdk-containers#332); keep 24.04",
      "matchDatasources": [
        "github-runners"
      ],
      "matchPackageNames": [
        "ubuntu"
      ],
      "allowedVersions": "/^24\\.04(?:-arm)?$/"
    }
  ]
}
